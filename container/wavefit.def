Bootstrap: docker
From: pytorch/pytorch:2.5.0-cuda12.1-cudnn9-devel

%post
    set -eux

    apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

    python -m pip install -U --no-cache-dir pip wheel
    python -m pip install -U --no-cache-dir setuptools==81.0.0

    # torchaudio and other audio libraries

    python -m pip install -U --no-cache-dir \
        torchaudio==2.5.* \
        "torchcodec==0.1.*" \
        pysoundfile==0.9.0 \
        librosa julius

    # training

    python -m pip install --no-cache-dir -U accelerate hydra-core wandb ema-pytorch

    # plot
    python -m pip install --no-cache-dir -U pillow matplotlib


%environment
    export PYTHONIOENCODING=utf-8